{
  "name": "frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-sw.js && vite",
    "build": "node scripts/generate-sw.js && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "vite preview --port $PORT --host",
    "prepare": "test -f node_modules/.bin/husky && husky || echo \"husky skipped\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "VITE_ENABLE_ENCRYPTION=true playwright test"
  },
  "dependencies": {
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.3.1",
    "firebase": "^12.18.0",
    "firebase-functions": "^7.4.0",
    "html-to-image": "^1.11.13",
    "i18next": "^26.5.10",
    "i18next-browser-languagedetector": "^8.2.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --fix"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
