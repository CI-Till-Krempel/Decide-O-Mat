rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /decisions/{decisionId} {
      // All authenticated users (including anonymous) may read decisions.
      // Anonymous sign-in is enforced client-side, so this effectively
      // requires the user to have loaded the app.
      allow read: if request.auth != null;
      allow write: if false; // Only manageable via Cloud Functions

      match /finalVotes/{userId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /arguments/{argumentId} {
        allow read: if request.auth != null;
        allow write: if false;

        match /votes/{userId} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }

      match /participants/{userId} {
        allow read: if request.auth != null;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
          && request.resource.data.fcmToken is string
          && request.resource.data.fcmToken.size() < 500;
        allow create, delete: if false;
      }
    }
  }
}
